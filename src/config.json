      "top": { "x": 0.195, "y": 5.870, "z": 0.189 }
    },
    "viewTargets": {
      "top": { "x": -0.005, "y": 0.868, "z": -0.011 }
    }
  },
  "ui": {
    "sections": ["setup", "color", "upload", "text", "quote", "saved"],
